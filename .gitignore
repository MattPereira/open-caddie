# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local

# Scorecard eval model outputs (regenerable)
evals/scorecard-import/runs/

# Image-viewer sidecar metadata
.comments/

# Project-local Neon CLI credentials and state
/.neon-local/

# Stryker mutation testing
.stryker-tmp/
reports/
stryker.log

# Local staging for browser-loop screenshots. Upload them for a PR with
# scripts/pr-screenshots.sh; the folder itself stays so save paths always exist.
/screenshots/*
!/screenshots/.gitkeep

# Original image-generation drops; optimized assets live under public/seed/.
/scripts/seed/images/raw/

# setup-agent: per-server tsconfigs (see next.config.ts)
/tsconfig.bug-*.json

# `pnpm dev:agent`'s state and log, one server per checkout.
/.dev-agent/
