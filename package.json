{
  "name": "open-caddie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:prod": "tsx src/seed/prod-copy.ts dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm run format:check && pnpm run lint && pnpm run lint:boundaries && pnpm run typecheck && pnpm run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:boundaries": "depcruise --cache --cache-strategy content src && depcruise --config .dependency-cruiser.runtime.cjs \"src/modules/*/index.ts\" && node scripts/check-module-tests.mjs",
    "typecheck": "next typegen && node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project db",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run --mutate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-migrations": "tsx src/db/check-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "env:pull": "vercel env pull .env.local --environment=development",
    "db:seed": "tsx --import ./src/seed/register.mjs src/seed/index.ts",
    "db:reset": "tsx src/seed/reset.ts && pnpm db:seed",
    "db:copy-prod": "tsx src/seed/prod-copy.ts copy",
    "db:sign-in": "tsx --import ./src/seed/register.mjs src/seed/sign-in.ts",
    "db:sign-in:prod": "tsx src/seed/prod-copy.ts sign-in",
    "spike:scorecard": "tsx evals/scorecard-import/spike.ts",
    "neon": "neon --config-dir .neon-local --no-analytics",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.112",
    "@ai-sdk/google": "^3.0.80",
    "@auth/drizzle-adapter": "^1.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.177",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.7.2",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.1",
    "neon": "9.2.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pg": "^8.20.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
